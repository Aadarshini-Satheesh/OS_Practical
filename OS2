Program 1 – Greatest Among Three Numbers
Aim: To find the greatest among three given numbers.
#!/bin/bash
echo "ENTER THREE NUMBERS"
read a b c
if [ $a -gt $b ] && [ $a -gt $c ]
then
 echo "$a is greater"
elif [ $b -gt $c ]
then
 echo "$b is greater"
else
 echo "$c is greater"
fi
Output (Input: 10 25 7):
ENTER THREE NUMBERS
25 is greater
Program 2 – Factorial of a Given Number
Aim: To find the factorial of a given number.
#!/bin/bash
echo "ENTER THE NUMBER:"
read n
fact=1
while [ $n -gt 1 ]
do
 fact=$((fact * n))
 n=$((n - 1))
done
echo "FACTORIAL OF THE GIVEN NUMBER IS $fact"
Output (Input: 5):
ENTER THE NUMBER:
FACTORIAL OF THE GIVEN NUMBER IS 120
Program 3 – Sum of Odd Numbers up to N
Aim: To find the sum of odd numbers up to N.
#!/bin/bash
echo "ENTER THE RANGE:"
read n
x=1
sum=0
while [ $x -le $n ]
do
 sum=$((sum + x))
 x=$((x + 2))
done
echo "SUM = $sum"
